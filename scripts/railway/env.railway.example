# Copy to `.env.railway` in the repo root (gitignored by `.env*`) and fill in.
# scripts/railway/setup.sh pushes every non-empty key here to the `frontend` service.
#
# DO NOT put these here — the script derives them from the Railway topology:
#   PORT, INTERNAL_API_URL, REQUIRE_INTERNAL_API_URL, NEXT_PUBLIC_API_URL,
#   NEXT_PUBLIC_SOCKET_URL, NEXT_PUBLIC_BASE_URL, NEXTAUTH_URL
#
# All NEXT_PUBLIC_* values are baked into the browser bundle at build time.

# ── Auth ── leave blank to auto-generate (never reuse the local value)
NEXTAUTH_SECRET=

# ── Sign-in providers ── add the Railway frontend domain to the OAuth client origins
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=

# ── Maps ── restrict this key by HTTP referrer to the Railway / custom domains
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Real-time ── websocket is required once the backend runs >1 replica (no sticky sessions)
NEXT_PUBLIC_SOCKET_TRANSPORT_MODE=websocket

# ── Optional ── extra image hosts for next/image (comma-separated hostnames)
IMAGE_REMOTE_HOSTS=
